{
   "name": "@encore/monorepo",
   "private": true,
   "workspaces": [
      "apps/*"
   ],
   "type": "module",
   "scripts": {
      "dev": "bun run --cwd apps/main dev",
      "dev:all": "turbo run dev",
      "dev:web": "bun run --cwd apps/web dev",
      "build": "bun run --cwd apps/main build",
      "build:watchdog": "bun run --cwd apps/main build:watchdog",
      "build:all": "turbo run build",
      "build:web": "bun run --cwd apps/web build",
      "deploy:web": "bun run build:web && bun run --cwd apps/web wrangler pages deploy --branch main",
      "start": "bun run --cwd apps/main start",
      "typecheck": "bun run --cwd apps/main typecheck",
      "typecheck:all": "turbo run typecheck",
      "test": "bun run --cwd apps/main test",
      "test:all": "turbo run test",
      "lint": "bun run --cwd apps/main lint",
      "lint:all": "turbo run lint",
      "format": "oxfmt .",
      "format:check": "oxfmt --check .",
      "electron:install": "bun run --cwd apps/main electron:install",
      "package": "bun run --cwd apps/main package",
      "package:dir": "bun run --cwd apps/main package:dir",
      "prepare": "husky"
   },
   "devDependencies": {
      "husky": "9.1.7",
      "lint-staged": "17.0.4",
      "oxfmt": "0.47.0",
      "oxlint": "1.62.0",
      "turbo": "2.10.8"
   },
   "trustedDependencies": [
      "electron",
      "esbuild"
   ],
   "packageManager": "bun@1.3.14",
   "engines": {
      "node": ">=24.15.0 <25",
      "bun": ">=1.3.13 <2"
   }
}
