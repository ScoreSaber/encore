{
   "name": "encore",
   "version": "0.1.6",
   "description": "A lightweight desktop companion for managing Beat Saber installs, mods and other user generated content",
   "author": "ScoreSaber",
   "license": "GPL-2.0-only",
   "desktopName": "com.scoresaber.encore",
   "private": true,
   "workspaces": [
      "web"
   ],
   "type": "module",
   "main": "out/main/index.js",
   "scripts": {
      "dev": "electron-vite dev",
      "dev:all": "turbo run dev",
      "dev:web": "turbo run dev --filter=@encore/web",
      "predev": "install-electron",
      "build": "electron-vite build && bun run typecheck",
      "build:watchdog": "bun run scripts/build-watchdog.ts",
      "build:all": "turbo run build",
      "build:web": "turbo run build --filter=@encore/web",
      "deploy:web": "bun run build:web && bun run --cwd web pages:deploy",
      "start": "electron-vite preview",
      "prestart": "install-electron",
      "typecheck": "tsc --noEmit",
      "typecheck:all": "turbo run typecheck",
      "test": "bun test",
      "lint": "oxlint src/ scripts/ electron.vite.config.ts",
      "lint:all": "turbo run lint",
      "format": "oxfmt .",
      "format:check": "oxfmt --check .",
      "electron:install": "install-electron",
      "package": "bun run build && bun run build:watchdog && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
      "package:dir": "bun run build && bun run build:watchdog && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
      "postinstall": "install-electron",
      "prepare": "husky"
   },
   "dependencies": {
      "@peculiar/x509": "1.14.3",
      "@tanstack/history": "1.162.0",
      "@tanstack/react-query": "5.101.2",
      "@tanstack/react-router": "1.170.16",
      "@tanstack/react-table": "8.21.3",
      "@tanstack/react-virtual": "3.14.8",
      "better-result": "2.8.2",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "crc-32": "1.2.2",
      "electron-updater": "6.8.9",
      "fflate": "0.8.3",
      "input-otp": "1.4.2",
      "lucide-react": "1.11.0",
      "radix-ui": "1.4.3",
      "react": "19.2.5",
      "react-colorful": "5.8.0",
      "react-dom": "19.2.5",
      "react-markdown": "10.1.0",
      "remark-gfm": "4.0.1",
      "semver": "7.8.5",
      "sonner": "2.0.7",
      "tailwind-merge": "3.5.0",
      "use-intl": "4.13.0",
      "valve-kv": "1.2.1",
      "yauzl": "3.4.0",
      "zod": "4.4.3"
   },
   "devDependencies": {
      "@electron-toolkit/utils": "4.0.0",
      "@tailwindcss/vite": "4.3.2",
      "@tanstack/router-plugin": "1.168.18",
      "@types/bun": "1.3.14",
      "@types/node": "24.12.2",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@types/semver": "7.7.1",
      "@types/yauzl": "3.4.0",
      "@vitejs/plugin-react": "6.0.3",
      "electron": "43.0.0",
      "electron-builder": "26.15.3",
      "electron-vite": "5.0.0",
      "husky": "9.1.7",
      "lint-staged": "17.0.4",
      "oxfmt": "0.47.0",
      "oxlint": "1.62.0",
      "tailwindcss": "4.3.2",
      "turbo": "2.10.8",
      "tw-animate-css": "1.4.0",
      "typescript": "5.9.3",
      "vite": "8.1.2"
   },
   "build": {
      "appId": "com.scoresaber.encore",
      "productName": "Encore",
      "directories": {
         "buildResources": "assets",
         "output": "release"
      },
      "files": [
         "out/**/*",
         "package.json",
         "!**/node_modules/**"
      ],
      "icon": "assets/encore-icon.png",
      "asar": true,
      "electronLanguages": "en-US",
      "npmRebuild": false,
      "fileAssociations": [
         {
            "ext": "bplist",
            "name": "Beat Saber playlist",
            "description": "Beat Saber playlist",
            "role": "Viewer",
            "mimeType": "application/x-beatsaber-playlist"
         }
      ],
      "publish": [
         {
            "provider": "github",
            "owner": "ScoreSaber",
            "repo": "encore"
         }
      ],
      "protocols": [
         {
            "name": "Encore launch link",
            "schemes": [
               "encore"
            ],
            "role": "Viewer"
         }
      ],
      "mac": {
         "target": [
            "dmg",
            "zip"
         ],
         "category": "public.app-category.utilities",
         "darkModeSupport": true,
         "identity": null,
         "notarize": false,
         "artifactName": "${productName}-${version}-macos-${arch}.${ext}"
      },
      "dmg": {
         "filesystem": "HFS+",
         "sign": false
      },
      "win": {
         "target": [
            "nsis"
         ],
         "verifyUpdateCodeSignature": false,
         "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
         "extraResources": [
            {
               "from": "build/watchdog/encore-watchdog.exe",
               "to": "encore-watchdog.exe"
            }
         ]
      },
      "nsis": {
         "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
         "differentialPackage": true
      },
      "linux": {
         "target": [
            "AppImage",
            "deb",
            "rpm",
            "flatpak"
         ],
         "category": "Utility",
         "maintainer": "ScoreSaber <contact@scoresaber.com>",
         "vendor": "ScoreSaber",
         "syncDesktopName": true,
         "extraResources": [
            {
               "from": "build/watchdog/encore-watchdog",
               "to": "encore-watchdog"
            }
         ],
         "desktop": {
            "entry": {
               "StartupWMClass": "encore",
               "Keywords": "beat saber;mods;maps;playlists;"
            }
         }
      },
      "appImage": {
         "artifactName": "${productName}-${version}-linux-x86_64.${ext}"
      },
      "deb": {
         "artifactName": "${productName}-${version}-linux-amd64.${ext}"
      },
      "rpm": {
         "artifactName": "${productName}-${version}-linux-x86_64.${ext}"
      },
      "flatpak": {
         "artifactName": "${productName}-${version}-linux-x86_64.${ext}",
         "runtimeVersion": "25.08",
         "baseVersion": "25.08",
         "finishArgs": [
            "--share=ipc",
            "--share=network",
            "--socket=wayland",
            "--socket=x11",
            "--socket=pulseaudio",
            "--device=all",
            "--filesystem=home",
            "--filesystem=/media",
            "--filesystem=/run/media",
            "--filesystem=~/.var/app/com.valvesoftware.Steam",
            "--talk-name=org.freedesktop.Flatpak",
            "--talk-name=org.freedesktop.Notifications"
         ]
      }
   },
   "trustedDependencies": [
      "electron",
      "esbuild"
   ],
   "packageManager": "bun@1.3.14",
   "engines": {
      "node": ">=24.15.0 <25",
      "bun": ">=1.3.13 <2"
   }
}
