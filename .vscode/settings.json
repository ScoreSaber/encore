{
   "files.exclude": {
      ".react-router": true,
      ".source": true,
      "node_modules": true,
      "out": true,
      "release": true
   },
   "search.exclude": {
      ".react-router": true,
      ".source": true,
      "node_modules": true,
      "out": true,
      "release": true
   },
   "editor.defaultFormatter": "oxc.oxc-vscode",
   "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
   "[javascriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
   "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
   "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
   "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit"
   },
   "editor.formatOnSave": true,
   "editor.formatOnSaveMode": "file",
   "npm.scriptRunner": "vp",
   "oxc.disableNestedConfig": true,
   "oxc.fmt.disableNestedConfig": true,
   "tailwindCSS.classFunctions": ["clsx", "cva", "twMerge"],
   "tailwindCSS.experimental.configFile": {
      "apps/main/src/renderer/styles/globals.css": "apps/main/src/**/*.{css,ts,tsx}",
      "apps/web/src/global.css": "apps/web/src/**/*.{css,ts,tsx}"
   },
   "tailwindCSS.files.exclude": ["**/.git/**", "**/node_modules/**", "**/out/**", "**/release/**"],
   "i18n-ally.enabledFrameworks": ["react-i18next"],
   "i18n-ally.localesPaths": ["apps/main/src/renderer/i18n"],
   "i18n-ally.sourceLanguage": "en"
}
