{
  "name": "@encore/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "fumadocs-mdx && next dev",
    "build": "fumadocs-mdx && next build",
    "start": "serve out",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "lint": "oxlint src source.config.ts next.config.mjs postcss.config.mjs",
    "postinstall": "fumadocs-mdx",
    "pages:preview": "wrangler pages dev out",
    "pages:deploy": "wrangler pages deploy --branch main"
  },
  "dependencies": {
    "@orama/orama": "3.1.18",
    "fumadocs-core": "16.9.0",
    "fumadocs-mdx": "15.0.7",
    "fumadocs-ui": "16.9.0",
    "lucide-react": "1.16.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/mdx": "2.0.13",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.15",
    "serve": "14.2.6",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "wrangler": "4.113.0"
  }
}
