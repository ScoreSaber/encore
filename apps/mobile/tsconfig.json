{
   "compilerOptions": {
      "target": "es2022",
      "lib": ["dom", "dom.iterable", "esnext"],
      "skipLibCheck": true,
      "strict": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noUncheckedIndexedAccess": true,
      "noEmit": true,
      "esModuleInterop": true,
      "module": "esnext",
      "moduleResolution": "bundler",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "jsx": "react-jsx",
      "types": ["node", "vite/client"],
      "paths": {
         "@/*": ["../main/src/*"]
      }
   },
   "include": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "scripts/**/*.ts",
      "capacitor.config.ts",
      "vite.config.ts",
      "../main/src/renderer/window.d.ts",
      "../main/src/renderer/i18n/global.d.ts",
      "../main/src/vite-env.d.ts"
   ]
}
