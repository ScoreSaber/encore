{
   "compilerOptions": {
      "target": "es2022",
      "lib": ["dom", "dom.iterable", "es2022"],
      "module": "esnext",
      "moduleResolution": "bundler",
      "strict": true,
      "skipLibCheck": true,
      "noEmit": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noUncheckedIndexedAccess": true,
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "types": ["node", "vite/client"],
      "paths": { "@/*": ["../main/src/*"] }
   },
   "include": ["src/**/*.ts", "build.ts"]
}
